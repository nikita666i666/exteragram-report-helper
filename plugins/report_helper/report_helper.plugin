
from typing import Any, Dict
from base_plugin import BasePlugin, MenuItemData, MenuItemType

__id__ = "report_helper"
__name__ = "Report Helper"
__description__ = "Помощник для подготовки жалоб"
__author__ = "Nikita"
__version__ = "1.0.0"
__app_version__ = ">=13.1.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["tools", "privacy"]


class ReportHelperPlugin(BasePlugin):

    def on_plugin_load(self):
        self.profile_item_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.PROFILE_ACTION_MENU,
                text="Подготовить жалобу",
                on_click=self.handle_profile_click,
                icon="msg_info"
            )
        )
        self.logger.info("Report Helper загружен")

    def handle_profile_click(self, context: Dict[str, Any]):
        self.logger.info(
            "Нажат пункт подготовки жалобы. Данные: %s",
            list(context.keys())
        )

        user = context.get("user")
        if user:
            self.logger.info(
                "Выбран пользователь: %s (ID: %s)",
                user.first_name,
                user.id
            )

    def on_plugin_unload(self):
        self.logger.info("Report Helper выгружен")
